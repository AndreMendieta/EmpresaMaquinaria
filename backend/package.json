{
  "name": "empresamaquinaria-backend",
  "version": "1.0.0",
  "description": "API de autenticación (PostgreSQL + JWT) para la app EmpresaMaquinaria",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "test": "node -e \"process.env.NODE_ENV='test'; require('./test-suite')\"",
    "migrate": "node src/db/migrate.js",
    "migrate:test": "node -e \"process.env.NODE_ENV='test'; require('./src/db/migrate')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.12.0"
  }
}
