# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub.

# Cadena de conexión que te da Neon / Render / Railway al crear la base PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Clave secreta para firmar los JWT. Genera una larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_algo_largo_y_aleatorio

# Puerto local (Render lo asigna automáticamente en producción)
PORT=3000
