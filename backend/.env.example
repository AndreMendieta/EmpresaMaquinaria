# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub.

# Cadena de conexión que te da Neon / Render / Railway al crear la base PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Clave secreta para firmar los JWT. Genera una larga y aleatoria, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_algo_largo_y_aleatorio

# Puerto local (Render lo asigna automáticamente en producción)
PORT=3000

# Proveedor opcional del asistente técnico
OPENAI_API_KEY=pega_aqui_tu_clave
OPENAI_MODEL=gpt-4o-mini

# Brevo SMTP para enviar códigos de verificación y recuperación.
# Obtén el usuario y la clave SMTP desde Settings > SMTP & API en Brevo.
# SMTP_PASS debe ser una clave SMTP, no la contraseña de la cuenta ni una API key.
# Verifica el remitente/dominio en Brevo antes de enviar.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HydroTech <remitente-verificado@tu-dominio.com>"
